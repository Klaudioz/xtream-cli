#!/usr/bin/env bash
# xtream — check an Xtream Codes IPTV line and search / play its channels.
#
# Credentials come from ~/.config/xtream/<profile>.conf (see --help), so nothing
# secret ever lands in this repo.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/xtream"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/xtream"
CACHE_TTL="${XTREAM_CACHE_TTL:-21600}" # 6h
# What the last run made of each line, one tiny file per line, so a second
# sweep over the same dump can leave the known-dead alone. See history_note.
HIST_DIR="$CACHE_DIR/history"

# Big panels answer get_vod_streams with tens of megabytes, so the overall
# transfer budget has to be generous. Stalls are caught by the speed floor
# below, not by a short wall-clock cap.
CONNECT_TIMEOUT="${XTREAM_CONNECT_TIMEOUT:-15}"
TIMEOUT="${XTREAM_TIMEOUT:-300}"
# How many lines to work on at the same time. Left alone, it scales with the
# size of the dump (see batch_autoscale) — the work is almost all waiting on
# other people's servers, so a big file wants a wide fan-out and a handful of
# lines does not.
BATCH_CONCURRENCY="${XTREAM_BATCH_CONCURRENCY:-}"
JOBS_SET=""
[[ -n $BATCH_CONCURRENCY ]] && JOBS_SET=1
BATCH_CONNECT_TIMEOUT="${XTREAM_BATCH_CONNECT_TIMEOUT:-8}"
# A single line is worth waiting 300s for; one line out of thousands is not —
# a panel that trickles for five minutes would hold its slot the whole time.
# --stats keeps the long budget, since it pulls whole catalogues.
BATCH_TIMEOUT="${XTREAM_BATCH_TIMEOUT:-90}"
SPEED_LIMIT="${XTREAM_SPEED_LIMIT:-1024}" # bytes/sec …
SPEED_TIME="${XTREAM_SPEED_TIME:-30}"     # … sustained for this long = dead
PROBE_TIMEOUT="${XTREAM_PROBE_TIMEOUT:-20}"

PROFILE="${XTREAM_PROFILE:-default}"
KIND="live"
REFRESH=""
STATS=""
ONLY=""           # --only: run just these line numbers of a dump
PROBE_CODE=""     # last http_probe_stream result …
PROBE_REASON=""   # … and a short reason ("HTTP 458", "placeholder")
CATQ=""           # --category: restrict search/url to matching categories
MUST=""           # --must: channels a line has to carry to be of any use
TZQ=""            # --timezone: skip lines whose server sits somewhere else
SHOW_ALL=""       # --all: keep the dead/refused rows in a batch listing
SKIP_SEEN=""      # --skip: seconds within which a known-dead line is left alone
SKIP_SPEC=""      # … as it was typed ("7d"), which is what to say back
STALKER=""        # set when the active line is a Stalker/Ministra portal
STALKER_PORTAL=""
STALKER_MAC=""

OUT_FILE=""       # --out: mirror everything to this file
XT_OUT_FIFO=""
XT_OUT_PID=""

# Captured once, up front: --out replaces stdout with a pipe, and later checks
# would then think they are being piped and drop colours/alignment.
ISATTY=""
if [[ -t 1 ]]; then
  ISATTY=1
  R=$'\033[31m' G=$'\033[32m' Y=$'\033[33m' B=$'\033[34m' D=$'\033[2m' N=$'\033[0m'
else
  R="" G="" Y="" B="" D="" N=""
fi

# die() often fires inside $(...), where a bare `exit` would only kill the
# subshell and let the caller carry on with empty output. Signal the top shell.
TOP_PID=$$
trap 'exit 1' TERM

die() {
  echo "${R}xtream:${N} $*" >&2
  kill -s TERM "$TOP_PID" 2>/dev/null
  exit 1
}

fmt_duration() {
  local s="$1"
  if ((s < 60)); then printf '%ds' "$s"
  elif ((s < 3600)); then printf '%dm %02ds' "$((s / 60))" "$((s % 60))"
  else printf '%dh %02dm %02ds' "$((s / 3600))" "$(((s % 3600) / 60))" "$((s % 60))"; fi
}

# Is "$1" the filename for -o, or the next argument? Guessing wrong would
# silently write the run to a file named "search", so anything that looks like
# a flag or a command means "no filename given, pick one".
out_takes_value() {
  case "${1:-}" in
  "" | -*) return 1 ;;
  status | quick | batch | lines | history | search | categories | cats | url | play | check | counts | playable | save | raw | help)
    return 1 ;;
  esac
  return 0
}

# Mirror everything this run prints — stdout and stderr — into a file, while
# the terminal keeps its colours. One awk with two destinations rather than
# `tee`, so the EXIT handler has a single pid to wait on and the file is
# guaranteed complete when the command returns.
setup_out() {
  local f="${1:-}"
  [[ -n $f ]] || f="xtream-$(date +%Y%m%d-%H%M%S).txt"
  : >"$f" || die "cannot write $f"
  OUT_FILE="$f"

  # fd 9 stays attached to the terminal, so progress can be shown live
  # without landing in the file.
  exec 9>&2
  XT_OUT_FIFO="$(mktemp -u "${TMPDIR:-/tmp}/xtream-out.XXXXXX")"
  mkfifo "$XT_OUT_FIFO" || die "cannot create $XT_OUT_FIFO"
  awk -v f="$f" -v esc="$(printf '\033')" '
    { s = $0; gsub(esc "\\[[0-9;]*m", "", s); print s > f; fflush(f); print; fflush() }
  ' <"$XT_OUT_FIFO" &
  XT_OUT_PID=$!
  exec >"$XT_OUT_FIFO" 2>&1
  echo "${D}saving output to $f${N}"
}

# Always report the wall clock: these runs go from "instant, cached" to
# "overnight over thousands of lines", and the number is the only way to tell
# which one you just did.
xtream_finish() {
  local rc=$?
  if [[ -n $ISATTY ]]; then
    printf '%stook %s%s\n' "$D" "$(fmt_duration "$SECONDS")" "$N" >&2
  fi
  if [[ -n $XT_OUT_PID ]]; then
    exec >&- 2>&-
    wait "$XT_OUT_PID" 2>/dev/null || true
    rm -f "$XT_OUT_FIFO"
  fi
  return $rc
}
trap xtream_finish EXIT

usage() {
  cat <<'EOF'
xtream — check an Xtream Codes IPTV line and search / play its channels.

USAGE
  xtream <FILE|CODE> [-n N] [command]    # work through a dump of many lines
  xtream <PLAYLIST-URL> [command]        # test a playlist you were just sent
  xtream [options] <command> [args]      # use a saved profile

THE USUAL JOB — A FILE FULL OF LINES
  1 · Which lines carry what you want, and can actually play it?

      xtream lines.txt -z london -m 'sky sports' playable uk -o good.txt

    The one pass that matters. Read it as: of every line in the file, keep the
    ones on a British server (-z), that carry channels matching "uk", that have
    Sky Sports among them (-m), and that will actually stream one. Ranked, best
    first:

       1. line 53 · someuser  1270 ch  must 1/1  exp 2026-10-11  conn 1/3  Europe/London
          UK ENTERTAINMENT 620 · UK SPORTS 210 · UK NEWS 44
          http://panel.example.com:8080/get.php?username=someuser&password=…

    The middle line is what it carries, by category and size — 1270 channels
    are worth nothing if none of them is the football. Then the playlist URL,
    and the same thing as the three fields a TV asks for, which is far less
    typing on a remote:

          tv: panel.example.com:8080  ·  someuser  ·  somepassword

    http:// is left off because TV apps assume it and it is the worst part to
    enter on a remote; if one refuses the address, put it back. https:// is
    always shown, and the port never comes off. The three are URL-decoded
    too, so a password written p%40ssw0rd in the dump shows as p@ssw0rd —
    what you actually have to type.

    The three filters, cheapest first:

      -z RX   the server's own timezone (Europe/London for a British panel).
              It comes from a tiny request, so lines that fail it never
              download a catalogue — this is what makes a sweep over
              thousands of lines quick. Expired lines are dropped here too.
      QUERY   matches a channel's name OR its category, because panels split
              evenly between "SKY SPORTS UK MAIN EVENT" filed under SPORTS
              and "SKY SPORTS MAIN EVENT" filed under UK SPORTS. -C RX
              restricts to the category alone when that is what you mean.
      -m LIST what the line has to carry, comma-separated, each one a regex,
              matched inside what QUERY already selected — which is what
              makes it unambiguous: with `playable uk`, `-m 'sky sports'` is
              the British feed, not the Italian or German Sky Sport. All of
              them have to be there.

    Everything else — wrong timezone, expired, no matching channels, missing a
    must-have, listed but refuses to stream, host long dead — is counted and
    left out, as are further accounts on a server already listed. -a keeps
    every line and says which of those it was.

  2 · What exactly does one of them carry?

      xtream lines.txt -n 53 search uk              # every matching channel
      xtream lines.txt -n 53 search 'sky|bt sport'  # narrow it down

    -n is the number from step 1, and takes @good.txt to mean "every line
    that worked in that run".

  3 · Does one particular channel really work?

      xtream lines.txt -n 53 check 98

    ffprobe against the real stream: codecs, resolution and frame rate if it
    plays, and the panel's own reason if it doesn't (a placeholder loop, a
    connection cap, a line barred from playback).

  4 · Watch it before committing to it.

      xtream lines.txt -n 53 play 98
      xtream lines.txt -n 53 play 'sky sports'      # a name works too

  With a single line selected, every other command behaves exactly as if you
  had handed xtream that line's URL:

      xtream lines.txt -n 53 lines        # that line's own get.php URL
      xtream lines.txt -n 53 quick        # status + categories + live count
      xtream lines.txt -n 53 url 98       # direct stream link
      xtream lines.txt -n 53 save uk      # keep it as a profile

  To rank a whole dump without caring what it carries, `status` is cheaper —
  it never downloads a catalogue:

      xtream lines.txt --stats status -o run.txt

TESTING A NEW PLAYLIST
  Paste the URL a provider gave you — get.php, player_api.php or a stream link.
  Credentials are read straight out of it, no setup:

    xtream 'http://host:8080/get.php?username=U&password=P&type=m3u_plus'

  With no command that prints a verdict (status + counts + categories). Any
  command works too, and `save` keeps the line for later:

    xtream 'http://host:8080/get.php?username=U&password=P' search espn
    xtream 'http://host:8080/get.php?username=U&password=P' save myprovider

  Quote the URL — & would background the command otherwise. Note the password
  lands in shell history; in zsh a leading space keeps it out (HIST_IGNORE_SPACE).

TESTING A SHARED DUMP (many lines at once)
  IPTV lines get passed around as a base64 paste code (often a paste.sh link),
  or just a text file full of URLs. Hand that code, the paste.sh URL, or a
  local file straight in and it decodes/decrypts/reads it, then runs your
  command against every line:

    xtream <base64-code>                      # status of every line
    xtream <base64-code> search bbc           # search each active line
    xtream <base64-code> check 12345
    xtream ~/Downloads/lines.txt              # a saved dump of get.php URLs
    xtream ~/Downloads/lines.txt search bbc

  Lines on a shared server hand out the same catalogue, so identical results
  are collapsed to "same as <first line>". Only active lines get the command.

  Add --stats to the status overview for per-line live/movie counts:

    xtream <base64-code> --stats

WORKING THROUGH A BIG DUMP
  The number in every row is the line's address for the rest of the session —
  no grepping the file for a username:

    xtream lines.txt lines                 # the index: which URL is line 3384
    xtream lines.txt -n 3384 search bbc    # one line
    xtream lines.txt -n 1-50,3384 status   # ranges and lists work too

  Results print as they land, so a long run shows rows all the way through.
  Knobs for a file with thousands of lines:

    -j N       how many lines to work on at the same time. Scales with the
               dump on its own (16 → 48); pass it only to override
    -T N       give up on a line after N seconds (default 90)
    -s DUR     skip lines a run in the last DUR found dead or expired
    -o FILE    mirror the whole run into FILE as well as the terminal
    --stats    slower: every line also downloads its full movie catalogue

  Channel lists are cached for 6h per line, so a second pass over the same
  dump is far cheaper than the first. Every run prints its wall-clock time.

COMING BACK TO A DUMP YOU ALREADY SWEPT
  Every sweep writes down what became of each line — server and username, never
  the password — under ~/.cache/xtream/history/. Two things come of that.

    xtream lines.txt history            # what the last runs made of each line

  …reads back per line: good (it worked), expired (the panel says so), dead
  (nothing answered), alive (it answered but didn't match the query), with how
  long ago that was and when it last worked. No network, so it is instant.

    xtream lines.txt -s 7d -z london playable uk

  …leaves out the lines a run in the last week found dead or expired, which on
  a dump that has been round the block once is most of them. Only those two
  verdicts are skipped: "didn't match" is an answer about a query, not about
  the line, so a different query still asks. -r rechecks everything, and -a
  lists what was skipped.

  Stalker/Ministra portals (MAC-based, no username/password) are handled
  too — a paste with "Panel ➤ … / Mac ➤ …" blocks expands like any other,
  and status/search/check/url/counts all work per MAC.

COMMANDS
  quick               Status + counts + categories (default for a bare URL)
  batch <src> [cmd]   Expand a base64/paste.sh dump or a local file and run
                      cmd on each line
  lines               (batch) Numbered index of the dump: number, user, URL
  history             (batch) What earlier runs made of each line, and when
  status              Account status: active/expired, expiry date, connections
  search [QUERY]      List channels whose name or category matches QUERY
                      (case-insensitive regex). No QUERY lists everything.
                      -C restricts to the category alone.
  categories          List categories for the current type
  url <ID|QUERY>      Print the direct stream URL
  play <ID|QUERY>     Play it in mpv. An id or a query that matches one
                      channel starts straight away; a wider query opens an
                      fzf picker.
  playable [QUERY]    Does this line carry these channels AND play them?
                      Filters on -z / QUERY / -m, streams one of what is
                      left, and lists what survived best first, with the URL
                      to type into a TV
  check <ID|QUERY>    Probe the stream with ffprobe — is it really alive?
  counts [WHAT…]      How many live channels / movies / series the line
                      carries. Name what you want (live, movies, series) to
                      skip the catalogues you don't.
  save [NAME]         Save the current line as profile NAME (default: "default")
  raw <ACTION>        Dump raw player_api.php JSON for ACTION (e.g. get_series)

OPTIONS
  -u, --url URL       Playlist URL to use instead of a saved profile
  -p, --profile NAME  Credential profile (default: $XTREAM_PROFILE or "default")
  -t, --type KIND     live (default) | vod | series
  -r, --refresh       Bypass the cached channel list
  -v, --stats         Batch status: add per-line live/movie counts (slower)
  -C, --category RX   Only channels whose category matches RX (regex, case-
                      insensitive). QUERY already matches categories too;
                      use this when only the category will do
  -m, --must LIST     playable: channels the line has to carry, comma-
                      separated, each one a regex, all matched within what
                      QUERY selected (`playable uk -m 'sky sports'`)
  -z, --timezone RX   playable: keep lines whose server reports a matching
                      timezone (e.g. london). Checked before any catalogue
                      is downloaded, so it is what makes a big sweep quick
  -n, --only SPEC     Batch: only these line numbers (12, 10-20, 1,5,900-905),
                      or @FILE to take them from a run you already have
  -a, --all           Batch: list the dead and refused lines too, not just
                      the ones that worked
  -s, --skip DUR      Batch: don't recheck lines a run in the last DUR found
                      dead or expired (7d, 12h, 30m; a bare number means
                      days). See `history`; -r rechecks them anyway
  -j, --jobs N        Batch: how many lines to work on at the same time.
                      Chosen from the size of the dump unless you set it.
  -o, --out [FILE]    Also write everything to FILE (colours stripped).
                      Without a name: xtream-YYYYmmdd-HHMMSS.txt
  -f, --force         Let `save` overwrite an existing profile
  -h, --help          This text

CONFIG
  Create ~/.config/xtream/default.conf (chmod 600):

    XTREAM_HOST=http://line.example.com:8080
    XTREAM_USER=myusername
    XTREAM_PASS=mypassword

  Add more providers as ~/.config/xtream/<name>.conf and reach them with
  `xtream -p <name> ...`. Any value may be a 1Password secret reference and is
  resolved with `op read`, e.g.:

    XTREAM_PASS=op://Private/IPTV/password

  Environment variables of the same name override the file.

EXAMPLES
  xtream lines.txt -z london -m 'sky sports' playable uk    # 1. the sweep
  xtream lines.txt -n 53 search uk                # 2. what line 53 carries
  xtream lines.txt -n 53 check 98                 # 3. does that channel work
  xtream lines.txt -n 53 play 98                  # 4. watch it
  xtream lines.txt --stats status -o run.txt      # rank the whole dump instead
  xtream lines.txt history                        # what earlier runs found
  xtream lines.txt -s 7d playable uk              # …and don't ask them again

  xtream 'http://host:8080/get.php?username=U&password=P'   # is this any good?
  xtream status
  xtream search 'espn|fox sports'
  xtream play cnn
  xtream check 12345
  xtream -t vod search dune
  xtream -p other status
EOF
}

# ------------------------------------------------------------------ config ---

# Pull host/username/password out of any Xtream URL a provider hands you:
#   http://host:8080/get.php?username=U&password=P&type=m3u_plus
#   http://host:8080/player_api.php?username=U&password=P
#   http://host:8080/live/U/P/12345.ts
parse_playlist_url() {
  local url="$1"
  [[ $url == http://* || $url == https://* ]] || url="http://$url"

  local scheme="${url%%://*}"
  local rest="${url#*://}"
  local hostport="${rest%%/*}"
  local tail="${rest#"$hostport"}"
  local u="" p="" kv

  [[ -n $hostport ]] || die "no host in that URL"

  if [[ $tail == *\?* ]]; then
    local IFS='&'
    for kv in ${tail#*\?}; do
      case "$kv" in
      username=*) u="${kv#username=}" ;;
      password=*) p="${kv#password=}" ;;
      esac
    done
  fi

  if [[ -z $u && $tail =~ ^/(live|movie|series)/([^/]+)/([^/]+)/ ]]; then
    u="${BASH_REMATCH[2]}"
    p="${BASH_REMATCH[3]}"
  fi

  [[ -n $u && -n $p ]] || die "no username/password in that URL — pass a get.php or player_api.php link"

  XTREAM_HOST="$scheme://$hostport"
  XTREAM_USER="$(urldecode "$u")"
  XTREAM_PASS="$(urldecode "$p")"
}

urldecode() {
  local s="$1"

  # Nothing to decode: pass through untouched rather than let printf %b eat a
  # backslash that is genuinely part of the password.
  if [[ $s != *%* && $s != *+* ]]; then
    printf '%s' "$s"
    return
  fi

  s="${s//+/ }"
  s="${s//\\/\\\\}"
  printf '%b' "${s//%/\\x}"
}

# --- batch: decode a shared dump into a list of Xtream URLs ----------------
#
# IPTV lines get passed around as a base64-encoded paste.sh link. Decode it,
# pull the ciphertext, decrypt it (paste.sh encrypts client-side with the key
# in the URL fragment), and scrape every get.php/player_api URL out.

# Base64 that decodes to an http(s) URL → the decoded URL; anything else → "".
maybe_base64_url() {
  local s="$1" dec
  [[ $s =~ ^[A-Za-z0-9+/=_-]+$ && ${#s} -ge 16 ]] || return 1
  dec="$(printf '%s' "$s" | base64 -d 2>/dev/null)" || return 1
  [[ $dec == http://* || $dec == https://* ]] || return 1
  printf '%s' "$dec"
}

# Decrypt a paste.sh URL (base#fragment) to plaintext on stdout.
# Mirrors paste.sh's own scheme: AES-256-CBC, key/IV via OpenSSL-style PBKDF2
# with SHA-512 and one iteration, password = id + serverkey + hash + origin.
# serverkey is empty for the public pastes these dumps use.
fetch_pastesh() {
  need openssl
  need python3
  local url="$1"
  local base="${url%%#*}" hash="${url#*#}"
  local id="${base##*/}"
  [[ -n $id && $hash != "$url" ]] || die "not a decryptable paste.sh URL (need the #key part)"

  # Fetch the ciphertext to a file, not a shell variable: big pastes run to
  # megabytes, and passing that to python via an env var blows past ARG_MAX
  # ("Argument list too long"). Python reads the file; only its short path
  # goes through the environment.
  local ctfile ok=1
  ctfile="$(mktemp "${TMPDIR:-/tmp}/xtream.XXXXXX")"
  curl -fsS --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TIMEOUT" "$base.txt" -o "$ctfile" \
    || { rm -f "$ctfile"; die "could not fetch paste $id"; }

  XT_CTFILE="$ctfile" XT_ID="$id" XT_HASH="$hash" python3 - <<'PY' || ok=0
import base64, hashlib, os, subprocess, sys

with open(os.environ["XT_CTFILE"], "rb") as fh:
    raw = fh.read()
blob = base64.b64decode(b"".join(raw.split()))
if blob[:8] != b"Salted__":
    sys.exit("no OpenSSL salt header")
salt, data = blob[8:16], blob[16:]

pw = (os.environ["XT_ID"] + "" + os.environ["XT_HASH"] + "https://paste.sh").encode()
kd = hashlib.pbkdf2_hmac("sha512", pw, salt, 1, 48)
key, iv = kd[:32].hex(), kd[32:48].hex()

p = subprocess.run(
    ["openssl", "enc", "-d", "-aes-256-cbc", "-K", key, "-iv", iv],
    input=data, capture_output=True)
if p.returncode:
    sys.exit(p.stderr.decode()[:200] or "openssl failed")
sys.stdout.buffer.write(p.stdout)
PY
  rm -f "$ctfile"
  ((ok)) || die "paste decryption failed — wrong key, or not a v3 paste"
}

# --- Stalker / Ministra portal client ---------------------------------------
#
# A different protocol from Xtream: the MAC is the credential, auth is a
# handshake→profile→bearer-token dance, and channels come with a per-item
# play URL. Runs the embedded Python client below.
#   stalker_run <command> [args]   (command: status|counts|search|url)
stalker_run() {
  need python3
  local refresh_env=""
  [[ -n $REFRESH ]] && refresh_env=1
  XTREAM_REFRESH="$refresh_env" \
    python3 - "$STALKER_PORTAL" "$STALKER_MAC" "$CACHE_DIR" "$@" <<'PY'
import sys, os, re, json, time, urllib.request, urllib.parse

UA = ("Mozilla/5.0 (QtEmbedded; U; Linux; C) AppleWebKit/533.3 "
      "(KHTML, like Gecko) MAG200 stbapp ver: 4 rev: 250 Safari/533.3")
CTO = int(os.environ.get("XTREAM_CONNECT_TIMEOUT", "15"))


def die(m):
    sys.stderr.write("xtream: " + m + "\n"); sys.exit(1)


class Portal:
    def __init__(self, portal, mac):
        m = re.match(r"(https?://[^/]+)", portal)
        if not m:
            die("bad portal URL: " + portal)
        self.origin = m.group(1)
        self.ref = portal if portal.endswith("/") else portal + "/"
        self.mac = mac
        self.token = None

    def _call(self, params):
        url = self.origin + "/portal.php?" + urllib.parse.urlencode(params)
        req = urllib.request.Request(url)
        req.add_header("User-Agent", UA)
        req.add_header("Referer", self.ref)
        req.add_header("X-User-Agent", "Model: MAG250; Link: WiFi")
        req.add_header("Cookie", "mac=%s; stb_lang=en; timezone=Europe/London"
                       % urllib.parse.quote(self.mac))
        if self.token:
            req.add_header("Authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=max(CTO, 20)) as r:
                raw = r.read().decode("utf-8", "replace")
        except Exception as e:
            die("portal request failed: %s" % e)
        try:
            return json.loads(raw)
        except ValueError:
            return {}

    def auth(self):
        j = self._call({"type": "stb", "action": "handshake",
                        "token": "", "JsHttpRequest": "1-xml"})
        self.token = (j.get("js") or {}).get("token")
        if not self.token:
            die("handshake failed — portal rejected the MAC or is down")
        self._call({"type": "stb", "action": "get_profile",
                    "hd": "1", "JsHttpRequest": "1-xml"})

    def account(self):
        return (self._call({"type": "account_info", "action": "get_main_info",
                            "JsHttpRequest": "1-xml"}).get("js")) or {}

    def channels(self, cachedir):
        key = re.sub(r"[^0-9A-Za-z]", "_", self.origin + "_" + self.mac)
        cf = os.path.join(cachedir, "stalker." + key + ".json")
        ttl = int(os.environ.get("XTREAM_CACHE_TTL", "21600"))
        if not os.environ.get("XTREAM_REFRESH") and os.path.exists(cf):
            if time.time() - os.path.getmtime(cf) < ttl and os.path.getsize(cf) > 2:
                with open(cf) as fh:
                    return json.load(fh)
        data = (self._call({"type": "itv", "action": "get_all_channels",
                            "JsHttpRequest": "1-xml"}).get("js") or {}).get("data") or []
        os.makedirs(cachedir, exist_ok=True)
        with open(cf + ".tmp", "w") as fh:
            json.dump(data, fh)
        os.replace(cf + ".tmp", cf)
        return data


def parse_expiry(phone):
    if not phone:
        return None, None
    for fmt in ("%B %d, %Y, %I:%M %p", "%B %d, %Y", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d"):
        try:
            t = time.strptime(phone.strip(), fmt)
            return time.strftime("%Y-%m-%d %H:%M", t), int((time.mktime(t) - time.time()) / 86400)
        except ValueError:
            continue
    return phone, None


def stream_url(cmd):
    return cmd.split(" ", 1)[1] if " " in cmd else cmd


portal, mac, cachedir, cmd = sys.argv[1:5]
args = sys.argv[5:]
p = Portal(portal, mac)

if cmd == "status":
    p.auth()
    exp, days = parse_expiry(p.account().get("phone"))
    print("server       " + p.origin)
    print("mac          " + mac)
    print("status       " + ("Active" if (days is None or days >= 0) else "Expired"))
    if exp:
        print("expires      " + exp + ("" if days is None else "  (%d days)" % days))
    print("connections  -")
elif cmd == "counts":
    p.auth()
    print("live    %d" % len(p.channels(cachedir)))
    print("movies  ?")
    print("series  ?")
elif cmd in ("search", "url"):
    p.auth()
    ch = p.channels(cachedir)
    if cmd == "search":
        q = args[0] if args else ""
        rx = re.compile(q, re.I) if q else None
        n = 0
        for c in ch:
            if rx is None or rx.search(c.get("name", "")):
                print("%s\t%s\t%s" % (c.get("id"), c.get("name", ""), "-")); n += 1
        if n == 0:
            die("no live channel matches '%s'" % q)
    else:
        if not args:
            die("usage: url <id|query>")
        arg = args[0]
        hit = next((c for c in ch if str(c.get("id")) == arg), None) if arg.isdigit() else None
        if hit is None:
            rx = re.compile(re.escape(arg), re.I)
            ms = [c for c in ch if rx.search(c.get("name", ""))]
            if len(ms) == 1:
                hit = ms[0]
            elif not ms:
                die("no channel matches '%s'" % arg)
            else:
                sys.stderr.write("%d matches for '%s' — narrow it down or pass an id:\n" % (len(ms), arg))
                for c in ms[:25]:
                    sys.stderr.write("  %s\t%s\n" % (c.get("id"), c.get("name", "")))
                sys.exit(1)
        link = p._call({"type": "itv", "action": "create_link",
                        "cmd": hit["cmd"], "JsHttpRequest": "1-xml"})
        url = stream_url((link.get("js") or {}).get("cmd") or "")
        if not url or "stream=&" in url:
            url = stream_url(hit["cmd"])
        print(url)
else:
