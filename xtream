}

# Emit every distinct Xtream line URL found in text on stdin. Handles the
# shapes these dumps come in:
#   1. full get.php / player_api.php URLs, one per line (or in "M3U:" lines)
#   2. a bare host line ("http://host:80") + a "user  pass  Expires" table
#   3. a host URL + "Username:/Password:" (or "User:/Pass:") pairs
#   4. Stalker portals: "Panel ➤ <portal>" + "Mac ➤ <mac>"
extract_xtream_urls() {
  awk '
    function emit(u) { if (!seen[u]++) print u }
    { line = $0; sub(/\r$/, "", line); sub(/[ \t]+$/, "", line); sub(/^[ \t]+/, "", line) }

    # (1) inline get.php / player_api.php URLs, anywhere on the line
    {
      s = line
      while (match(s, /https?:\/\/[^[:space:]"'"'"'<>]*(get\.php|player_api\.php)[^[:space:]"'"'"'<>]*/)) {
        emit(substr(s, RSTART, RLENGTH))
        s = substr(s, RSTART + RLENGTH)
      }
    }

    # (4) Stalker portals: "Panel ➤ http://host/c/" then "Mac ➤ 00:1A:..."
    line ~ /Panel/ && match(line, /https?:\/\/[^[:space:]]+/) {
      sp = substr(line, RSTART, RLENGTH); sub(/\/+$/, "", sp); stalker_portal = sp; next
    }
    match(line, /([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/) {
      if (stalker_portal != "") emit("stalker:" stalker_portal "#" substr(line, RSTART, RLENGTH))
      next
    }

    # Any scheme-qualified host URL sets the context for the rows/pairs beneath
    # it. Handles a bare line, a markdown-wrapped [http://h](http://h), or a
    # "Host: http://h" prefix. get.php URLs are excluded, so an "M3U:" line
    # never sets host — that keeps format (1) from being reconstructed twice.
    line !~ /(get\.php|player_api\.php)/ && match(line, /https?:\/\/[^][()[:space:]]+/) {
      host = substr(line, RSTART, RLENGTH); sub(/\/+$/, "", host)
    }

    # (3) "Username:/User:" then "Password:/Pass:" pairs under a host URL
    line ~ /^[Uu]ser(name)?:[ \t]*/ {
      pending_user = line; sub(/^[Uu]ser(name)?:[ \t]*/, "", pending_user); next
    }
    line ~ /^[Pp]ass(word)?:[ \t]*/ {
      pp = line; sub(/^[Pp]ass(word)?:[ \t]*/, "", pp)
      if (host != "" && pending_user != "" && pp != "")
        emit(host "/get.php?username=" pending_user "&password=" pp "&type=m3u_plus")
      pending_user = ""; next
    }

    # (2) "user  pass  [Expires…]" rows under a host — fields split on 2+ spaces
    host != "" {
      n = split(line, f, /[ \t][ \t]+/)
      if (n < 2) next
      u = f[1]; p = f[2]
      lu = tolower(u); lp = tolower(p)
      if (lu ~ /^(usr|user|username|login|line)$/ || lp ~ /^(pw|pass|password)$/) next
      if (u !~ /^[A-Za-z0-9._@+-]{2,}$/ || p !~ /^[A-Za-z0-9._@+-]{2,}$/) next
      emit(host "/get.php?username=" u "&password=" p "&type=m3u_plus")
    }
  '
}

# Turn a batch input (base64, paste.sh URL, or raw text URL) into a URL list.
resolve_batch_urls() {
  local input="$1" decoded text

  # A local file of dumped lines (however many, in any of the shapes above) is
  # scraped straight off disk — no fetch, no decode.
  if [[ -f $input ]]; then
    extract_xtream_urls <"$input"
    return
  fi

  decoded="$(maybe_base64_url "$input")" && input="$decoded"

  case "$input" in
  *paste.sh/*)
    text="$(fetch_pastesh "$input")" || exit 1
    printf '%s\n' "$text" | extract_xtream_urls
    ;;
  stalker:*)
    # A single Stalker portal token handed in directly.
    printf '%s\n' "$input"
    ;;
  http://*get.php* | https://*get.php* | http://*player_api* | https://*player_api*)
    # A single line handed in directly.
    printf '%s\n' "$input"
    ;;
  http://* | https://*)
    # Some other page/paste — fetch and scrape whatever Xtream URLs it holds.
    text="$(curl -fsS --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TIMEOUT" "$input")" \
      || die "could not fetch $input"
    printf '%s\n' "$text" | extract_xtream_urls
    ;;
  *)
    die "don't know how to expand that — pass a base64 paste code, a paste.sh URL, a get.php URL, or a local file"
    ;;
  esac
}

# Run one batch line to stdout. Reads sub/fwd/STATS from the caller (cmd_batch)
# via dynamic scope. With --stats on a status run, it also fetches counts so
# the overview can show channel totals.
run_line_once() {
  local url="$1"; shift
  if [[ $sub == status && -n ${STATS:-} ]]; then
    "$SELF" ${fwd[@]+"${fwd[@]}"} -u "$url" status
    # Only live/movies are shown, and every catalogue is a full download —
    # asking for the series list too would double the cost of --stats.
    "$SELF" ${fwd[@]+"${fwd[@]}"} -u "$url" counts live movies
  else
    "$SELF" ${fwd[@]+"${fwd[@]}"} -u "$url" "$sub" "$@"
  fi
}

# Servers under a burst of parallel requests hand back transient rejections
# (503/511/timeouts). Each line retries its own once, so a rate-limit is not
# mistaken for "line dead" — and, unlike a retry sweep after the fact, results
# stay final as they land, which is what lets the parent stream them in order.
batch_run_line() {
  local url="$1"; shift
  local out
  out="$(run_line_once "$url" "$@" 2>&1)" || true
  # Only what a burst of parallel requests can cause is worth a second go. A
  # host that doesn't resolve or refuses the connection is simply gone, and
  # retrying it doubles the cost of the bulk of a stale dump for nothing.
  if grep -qE 'curl: \(|request failed|server rejected|timed out' <<<"$out" &&
    ! grep -qE 'cannot resolve host|cannot connect to' <<<"$out"; then
    out="$(run_line_once "$url" "$@" 2>&1)" || true
    : >"$tmp/$i.retry"
  fi
  printf '%s\n' "$out"
}

# Expand a --only spec ("12", "3384", "10-20", "1,5,900-905") to line numbers.
expand_only() {
  local spec="$1" tok a b

  # -n @FILE: carry on from a run you already have —
  #   xtream dump.txt playable uk -o good.txt
  #   xtream dump.txt -n @good.txt search uk
  if [[ $spec == @* ]]; then
    local f="${spec#@}" nums
    [[ -r $f ]] || die "cannot read '$f' (from -n @FILE)"
    # A result row is "  3384. user …"; the digits-then-dot is what tells it
    # apart from the header and summary lines in the same file. Rows that
    # record a failure are dropped, so a file saved with -a (or by an older
    # version, when every line was listed) needs no filtering first.
    nums="$(grep -vE 'unreachable|rejected|refused|placeholder|no response|no matching|HTTP [0-9]{3}|Expired|Banned|Disabled' "$f" |
      sed -n 's/^[[:space:]]*\([0-9][0-9]*\)\..*/\1/p')"
    # …and a plain list of numbers works too.
    [[ -n $nums ]] || nums="$(grep -oE '^[[:space:]]*[0-9]+[[:space:]]*$' "$f" | tr -d '[:space:]' || true)"
    [[ -n $nums ]] || die "no line numbers found in '$f'"
    printf '%s\n' "$nums"
    return
  fi

  local IFS=','
  for tok in $spec; do
    if [[ $tok =~ ^[0-9]+$ ]]; then
      printf '%s\n' "$tok"
    elif [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
      a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"
      ((a <= b)) || die "--only range '$tok' runs backwards"
      for ((; a <= b; a++)); do printf '%s\n' "$a"; done
    else
      die "bad --only '$tok' — use N, N-M or a comma-separated list"
    fi
  done
}

# Nobody should have to guess a number here. The run is bound by how long
# other people's panels take to answer — dead lines burn the connect timeout
# twice — so wider is better the moment a dump gets big, while a handful of
# lines gains nothing from fanning out.
batch_autoscale() {
  [[ -z $JOBS_SET ]] || return 0
  local total="$1"
  if ((total <= 64)); then BATCH_CONCURRENCY=16
  elif ((total <= 512)); then BATCH_CONCURRENCY=32
  else BATCH_CONCURRENCY=48; fi
  ((BATCH_CONCURRENCY <= total)) || BATCH_CONCURRENCY=$total
}

# A "1234/3421 done" ticker for runs whose results only print at the end.
# Silent when the output is being captured, so no \r junk lands in a file.
batch_progress() {
  [[ -n $ISATTY ]] || return 0
  if [[ -n $OUT_FILE ]]; then
    printf '\r\033[2K  %s%d/%d done%s' "$D" "$1" "$2" "$N" >&9
  else
    printf '\r\033[2K  %s%d/%d done%s' "$D" "$1" "$2" "$N" >&2
  fi
}

batch_progress_clear() {
  [[ -n $ISATTY ]] || return 0
  if [[ -n $OUT_FILE ]]; then printf '\r\033[2K' >&9; else printf '\r\033[2K' >&2; fi
}

# One compact row per account, printed the moment that line finishes. Reads
# urls/idx/tmp/STATS and the n_* tallies from cmd_batch via dynamic scope.
render_status_row() {
  local pos="$1"
  local u="${urls[$((pos - 1))]}" n="${idx[$((pos - 1))]}"
  local user out st exp cons live movies colour
  user="$(batch_label "$u")"
  out="$(cat "$tmp/$pos.done" 2>/dev/null || true)"

  if ! grep -q '^status ' <<<"$out"; then
    n_dead=$((n_dead + 1))
    history_note "$u" dead unreachable
    [[ -n $SHOW_ALL ]] || return 0
    batch_progress_clear
    printf '  %4d. %-22s %s\n' "$n" "${user:-?}" "${R}unreachable/rejected${N}"
    return
  fi

  st="$(sed -n 's/^status *//p' <<<"$out" | sed 's/\x1b\[[0-9;]*m//g')"
  exp="$(sed -n 's/^expires *//p' <<<"$out" | sed 's/  .*//')"
  cons="$(sed -n 's/^connections *//p' <<<"$out")"
  cons="${cons:--}" # Stalker portals report no connection count
  colour="$G"
  if [[ $st == Active ]]; then
    n_active=$((n_active + 1))
    history_note "$u" good "-" "${exp:--}"
  else
    colour="$R"
    n_expired=$((n_expired + 1))
    history_note "$u" expired "${st:-expired}" "${exp:--}"
    [[ -n $SHOW_ALL ]] || return 0
  fi
  batch_progress_clear

  if [[ -n $STATS ]]; then
    live="$(sed -n 's/^live *//p' <<<"$out")"
    movies="$(sed -n 's/^movies *//p' <<<"$out")"
    printf '  %4d. %-22s %b%-8s%b exp %s  conn %-5s  live %-6s movies %s\n' \
      "$n" "${user:-?}" "$colour" "$st" "$N" "$exp" "$cons" "${live:-?}" "${movies:-?}"
  else
    printf '  %4d. %-22s %b%-8s%b exp %s  conn %s\n' \
      "$n" "${user:-?}" "$colour" "$st" "$N" "$exp" "$cons"
  fi
}

render_playable_row() {
  local pos="$1"
  local u="${urls[$((pos - 1))]}" n="${idx[$((pos - 1))]}"
  local user out verdict reason matches must host

  user="$(batch_label "$u")"
  out="$(cat "$tmp/$pos.done" 2>/dev/null || true)"

  if ! grep -q '^playable ' <<<"$out"; then
    n_dead=$((n_dead + 1))
    history_note "$u" dead unreachable
    [[ -n $SHOW_ALL ]] || return 0
    batch_progress_clear
    printf '  %4d. %-22s %s\n' "$n" "${user:-?}" "${R}unreachable/rejected${N}"
    return 0
  fi

  verdict="$(sed -n 's/^playable *//p' <<<"$out")"
  matches="$(sed -n 's/^matches *//p' <<<"$out")"
  must="$(sed -n 's/^must *//p' <<<"$out")"
  reason="$(sed -n 's/^reason *//p' <<<"$out")"

  if [[ $verdict != yes ]]; then
    n_expired=$((n_expired + 1))
    # Only the panel's own verdict is worth remembering. "no matching channel"
    # or a timezone it doesn't sit in is an answer to this query, not a fact
    # about the line, and skipping on it next time would hide a line that the
    # next query wants.
    case "$reason" in
    Expired* | Banned* | Disabled*) history_note "$u" expired "${reason%% *}" ;;
    *) history_note "$u" alive "${reason:-refused}" ;;
    esac
    [[ -n $SHOW_ALL ]] || return 0
    batch_progress_clear
    printf '  %4d. %-22s %b%s%b\n' "$n" "${user:-?}" "$R" "${reason:-refused}" "$N"
    return 0
  fi

  n_active=$((n_active + 1))
  history_note "$u" good "-" "$(sed -n 's/^expires *//p' <<<"$out")"

  # Accounts on one server hand out the same catalogue, and any one of them is
  # as good as the others for typing into a TV. Keep the first that works and
  # count the rest. (A plain string, not an associative array — bash 3.2.)
  host="${u#*://}"; host="${host%%/*}"
  case "$u" in
  https://*) host="${host%:443}" ;;
  *) host="${host%:80}" ;;
  esac
  if [[ -z $SHOW_ALL && $seen_hosts == *" $host "* ]]; then
    n_dup=$((n_dup + 1))
    return 0
  fi
  seen_hosts="$seen_hosts$host "

  # Sort keys first, so the ranked listing at the end can be built from the
  # files still on disk: must-haves matched, then how much it carries.
  rank_keys+=("${must%%/*}0 $matches $pos")

  batch_progress_clear
  render_playable_detail "" "$pos"
}

# The payoff, printed once the sweep is done: what each line carries, how long
# it lasts, and the string to type into the TV — best first.
render_playable_detail() {
  local rank="$1" pos="$2"
  local u="${urls[$((pos - 1))]}" n="${idx[$((pos - 1))]}"
  local out matches must sample exp cons tz user lead srv usr pw alias
  user="$(batch_label "$u")"
  out="$(cat "$tmp/$pos.done" 2>/dev/null || true)"
  matches="$(sed -n 's/^matches *//p' <<<"$out")"
  must="$(sed -n 's/^must *//p' <<<"$out")"
  sample="$(sed -n 's/^sample *//p' <<<"$out")"
  exp="$(sed -n 's/^expires *//p' <<<"$out")"
  cons="$(sed -n 's/^conns *//p' <<<"$out")"
  tz="$(sed -n 's/^tz *//p' <<<"$out")"
  srv="$(sed -n 's/^server *//p' <<<"$out")"
  alias="$(sed -n 's/^alias *//p' <<<"$out")"
  usr="$(sed -n 's/^user *//p' <<<"$out")"
  pw="$(sed -n 's/^pass *//p' <<<"$out")"

  # The ranked listing at the end numbers its entries; a hit printed as it is
  # found just says which line it is.
  if [[ -n $rank ]]; then lead="$(printf '%3d. ' "$rank")"; else lead="     "; fi

  printf '%s%bline %d · %s%b  %s ch%s%s%s%s\n' \
    "$lead" "$B" "$n" "$user" "$N" "${matches:-?}" \
    "${must:+  must $must}" "${exp:+  exp $exp}" "${cons:+  conn $cons}" \
    "${tz:+  $tz}"
  printf '     %s%s%s\n' "$D" "$sample" "$N"
  printf '     %s\n' "$u"
  # Typing this into a TV is the last step, and the three fields are what it
  # asks for. http:// comes off — TV apps assume it, and it is the most
  # tedious part to enter on a remote. https:// stays, since dropping that one
  # changes what you connect to. The port never comes off.
  if [[ -n $srv ]]; then
    case "$srv" in
    http://*) srv="${srv#http://}" ;;
    esac
    printf '     %stv:%s %s  ·  %s  ·  %s%s\n' "$D" "$N" "$srv" "$usr" "$pw" \
      "${alias:+  ${D}(panel calls itself $alias)${N}}"
  fi
  return 0
}

render_counts_row() {
  local pos="$1"
  local u="${urls[$((pos - 1))]}" n="${idx[$((pos - 1))]}"
  local user out live movies series
  user="$(batch_label "$u")"
  out="$(cat "$tmp/$pos.done" 2>/dev/null || true)"

  if ! grep -q '^live ' <<<"$out"; then
    n_dead=$((n_dead + 1))
    history_note "$u" dead unreachable
    [[ -n $SHOW_ALL ]] || return 0
    batch_progress_clear
    printf '  %4d. %-22s %s\n' "$n" "${user:-?}" "${R}unreachable/rejected${N}"
    return
  fi
  n_active=$((n_active + 1))
  history_note "$u" alive answered
  batch_progress_clear
  live="$(sed -n 's/^live *//p' <<<"$out")"
  movies="$(sed -n 's/^movies *//p' <<<"$out")"
  series="$(sed -n 's/^series *//p' <<<"$out")"
  printf '  %4d. %-22s live %-7s movies %-7s series %s\n' \
    "$n" "${user:-?}" "$live" "$movies" "$series"
}

# A short label for a batch line: the Xtream username, or the MAC for a
# Stalker portal token.
batch_label() {
  case "$1" in
  stalker:*) printf '%s' "${1##*#}" ;;
  *) sed -n 's/.*username=\([^&]*\).*/\1/p' <<<"$1" ;;
  esac
}

# ----------------------------------------------------------------- history ---
#
# A sweep is mostly spent on lines that were already dead the last time. One
# record per line remembers what became of it, so the next sweep can leave
# those alone — the same thing the cached catalogues do for the lines that
# work.
#
# Everything here is deliberately fork-free: it runs once per line of a dump,
# in the parent, between rendering results, and a command substitution there
# would cost thousands of subshells. Helpers set a global instead of printing.

# Seconds from "7d" / "12h" / "30m" / "90s". A bare number means days, which
# is the unit anyone reaching for --skip is thinking in.
parse_duration() {
  local v="$1" n="${1%[smhdwSMHDW]}"
  [[ $n =~ ^[0-9]+$ ]] || die "bad duration '$1' — use 30m, 12h, 7d"
  case "$v" in
  *s | *S) printf '%s' "$n" ;;
  *m | *M) printf '%s' $((n * 60)) ;;
  *h | *H) printf '%s' $((n * 3600)) ;;
  *w | *W) printf '%s' $((n * 604800)) ;;
  *) printf '%s' $((n * 86400)) ;;
  esac
}

# Sets AGE. "3d ago" is all anyone reads off a history listing.
fmt_age() {
  local s="$1"
  if ((s < 90)); then AGE="just now"
  elif ((s < 5400)); then AGE="$((s / 60))m ago"
  elif ((s < 172800)); then AGE="$((s / 3600))h ago"
  else AGE="$((s / 86400))d ago"; fi
}

# Sets HKEY: the identity of a line, which is its server and username — never
# the password, which has no business on disk. Line numbers can't be the key:
# the same line sits at a different number in the next dump.
history_key() {
  local u="$1" id user
  case "$u" in
  stalker:*) id="$u" ;;
  *)
    id="${u#*://}"
    id="${id%%/*}"
    user="${u#*username=}"
    [[ $user == "$u" ]] && user="" || user="${user%%&*}"
    id="${id}_${user}"
    ;;
  esac
  id="${id//[!A-Za-z0-9._-]/_}"
  HKEY="${id:0:150}"
}

# Sets HIST_TS / HIST_VERDICT / HIST_GOOD / HIST_EXP / HIST_NOTE from a record,
# non-zero if there isn't one. Fields are never empty on disk — with IFS set to
# a tab, bash collapses a run of them and every column after a blank would
# shift by one.
history_read() {
  local f="$HIST_DIR/$1"
  HIST_TS=0 HIST_VERDICT="" HIST_GOOD=0 HIST_EXP="-" HIST_NOTE="-"
  [[ -s $f ]] || return 1
  IFS=$'\t' read -r HIST_TS HIST_VERDICT HIST_GOOD HIST_EXP HIST_NOTE <"$f" || true
  [[ $HIST_TS =~ ^[0-9]+$ ]] || { HIST_TS=0; return 1; }
  [[ $HIST_GOOD =~ ^[0-9]+$ ]] || HIST_GOOD=0
  return 0
}

# Record what a line turned out to be. Verdicts are deliberately few:
#   good     it answered and is usable (a sweep hit, or an active account)
#   expired  the panel says Expired/Banned/Disabled
#   dead     nothing answered
#   alive    it answered but didn't qualify — a wrong timezone, a missing
#            channel. Never skipped, because that verdict depends on the query
#            and the next run may ask something else.
# Only the parent writes these, as each result lands, so two workers never
# touch one file.
history_note() {
  local u="$1" verdict="$2" note="${3:--}" exp="${4:--}" good=0
  history_key "$u"
  history_read "$HKEY" && good="$HIST_GOOD"
  [[ $verdict == good ]] && good="$HIST_NOW"
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$HIST_NOW" "$verdict" "$good" "${exp:--}" "${note:--}" \
    >"$HIST_DIR/$HKEY" 2>/dev/null || true
  return 0
}

cmd_batch() {
  [[ -n ${1:-} ]] || die "usage: xtream batch <base64-code|paste.sh URL|file> [command] [args]"
  local input="$1"
  shift

  # Flags typed after the code (e.g. `xtream '<code>' --stats`) land here, not
  # in the main option loop, so consume any that precede the sub-command.
  while [[ ${1:-} == -* ]]; do
    case "$1" in
    -v | --stats) STATS=1; shift ;;
    -r | --refresh) REFRESH=1; shift ;;
    -t | --type) KIND="${2:?--type needs live|vod|series}"; shift 2 ;;
    -j | --jobs) BATCH_CONCURRENCY="${2:?--jobs needs a number}"; JOBS_SET=1; shift 2 ;;
    -n | --only) ONLY="${2:?--only needs a line number, range or list}"; shift 2 ;;
    -C | --category) CATQ="${2:?--category needs a regex}"; shift 2 ;;
    -m | --must) MUST="${2:?--must needs a channel name (or a comma-separated list)}"; shift 2 ;;
    -z | --timezone) TZQ="${2:?--timezone needs a regex, e.g. london}"; shift 2 ;;
    -a | --all) SHOW_ALL=1; shift ;;
    -s | --skip)
      SKIP_SEEN="$(parse_duration "${2:?--skip needs a duration, e.g. 7d}")"
      SKIP_SPEC="$2"; shift 2 ;;
    -o | --out)
      if out_takes_value "${2:-}"; then setup_out "$2"; shift 2; else setup_out ""; shift; fi ;;
    -c | --connect-timeout)
      CONNECT_TIMEOUT="${2:?--connect-timeout needs seconds}"
      BATCH_CONNECT_TIMEOUT="$2"; shift 2 ;;
    -T | --timeout)
      TIMEOUT="${2:?--timeout needs seconds}"
      BATCH_TIMEOUT="$2"; shift 2 ;;
    *) die "unknown batch option '$1' (try --help)" ;;
    esac
  done

  local sub="${1:-status}"
  [[ $# -gt 0 ]] && shift

  local -a all=() urls=() idx=()
  local line k
  while IFS= read -r line; do [[ -n $line ]] && all+=("$line"); done < <(resolve_batch_urls "$input")

  ((${#all[@]})) || die "no Xtream lines found in that input"

  # --only keeps the numbering of the full run, so `--only 3384` reports line
  # 3384 exactly as it was labelled when the whole dump went through.
  if [[ -n ${ONLY:-} ]]; then
    for k in $(expand_only "$ONLY"); do
      ((k >= 1 && k <= ${#all[@]})) || die "--only $k is out of range (1-${#all[@]})"
      urls+=("${all[$((k - 1))]}"); idx+=("$k")
    done
  else
    for k in $(seq 1 ${#all[@]}); do urls+=("${all[$((k - 1))]}"); idx+=("$k"); done
  fi

  # `lines` is the index of the dump: which URL is line N. No network at all,
  # so it answers instantly even for a file with thousands of lines.
  if [[ $sub == lines ]]; then
    for k in $(seq 1 ${#urls[@]}); do
      # `xtream dump.txt lines | head` closes the pipe under us; that is not an
      # error worth printing.
      printf '  %4d. %-22s %s\n' \
        "${idx[$((k - 1))]}" "$(batch_label "${urls[$((k - 1))]}")" "${urls[$((k - 1))]}" 2>/dev/null || exit 0
    done
    return
  fi

  local HIST_NOW
  HIST_NOW="$(date +%s)"
  mkdir -p "$HIST_DIR" 2>/dev/null || true

  # `history` is what the last runs made of this dump: no network either, so
  # it answers instantly and says which lines a sweep would now skip.
  if [[ $sub == history ]]; then
    local hu hcol hdetail hage hn_known=0
    for k in $(seq 1 ${#urls[@]}); do
      hu="${urls[$((k - 1))]}"
      history_key "$hu"
      if ! history_read "$HKEY"; then
        printf '  %4d. %-22s %s\n' \
          "${idx[$((k - 1))]}" "$(batch_label "$hu")" "${D}never checked${N}"
        continue
      fi
      hn_known=$((hn_known + 1))
      fmt_age $((HIST_NOW - HIST_TS))
      hage="$AGE"
      case "$HIST_VERDICT" in
      good) hcol="$G"; hdetail="${HIST_EXP:--}"; [[ $hdetail == - ]] && hdetail="" || hdetail="exp $hdetail" ;;
      dead | expired) hcol="$R"; hdetail="$HIST_NOTE" ;;
      *) hcol="$Y"; hdetail="$HIST_NOTE" ;;
      esac
      [[ $hdetail == - ]] && hdetail=""
      # A line that has worked before is worth another look even if it is
      # down now, so say when it last did.
      if [[ $HIST_VERDICT != good ]] && ((HIST_GOOD > 0)); then
        fmt_age $((HIST_NOW - HIST_GOOD))
        hdetail="${hdetail:+$hdetail  }${D}last good $AGE${N}"
      fi
      printf '  %4d. %-22s %b%-8s%b %-10s %s\n' \
        "${idx[$((k - 1))]}" "$(batch_label "$hu")" \
        "$hcol" "$HIST_VERDICT" "$N" "$hage" "$hdetail"
    done
    echo
    echo "${D}── ${#urls[@]} lines · ${hn_known} on record · kept in $HIST_DIR${N}"
    return
  fi

  # One line selected — almost always `-n N` — is not a batch at all. Run it
  # here, in this shell, so it behaves exactly like handing xtream that line's
  # URL: full status block, working picker, mpv on the terminal, raw URL on
  # stdout. The batch machinery would fork it into a pipe and strand anything
  # interactive.
  if ((${#urls[@]} == 1)); then
    local host="${urls[0]#*://}"; host="${host%%/*}"
    [[ -n $ISATTY ]] && echo "${D}line ${idx[0]} · $(batch_label "${urls[0]}") · ${host}${N}" >&2
    URL_OVERRIDE="${urls[0]}"
    load_config
    run_command "$sub" "$@"
    return
  fi

  [[ $sub != play ]] || die "play needs one line — pick it with -n N (see 'xtream $input lines')"

  # --skip: most of a re-run over a stale dump is spent waiting on hosts that
  # were already gone last time. Drop those before a single request goes out.
  # Only dead and expired qualify — see history_note — and -r rechecks the lot.
  local n_skipped=0
  if [[ -n $SKIP_SEEN && -z $REFRESH ]]; then
    local -a sk_urls=() sk_idx=()
    local su sk_show=""
    [[ $SKIP_SPEC =~ ^[0-9]+$ ]] && SKIP_SPEC="${SKIP_SPEC}d"
    for k in $(seq 1 ${#urls[@]}); do
      su="${urls[$((k - 1))]}"
      history_key "$su"
      if history_read "$HKEY" &&
        [[ $HIST_VERDICT == dead || $HIST_VERDICT == expired ]] &&
        ((HIST_NOW - HIST_TS < SKIP_SEEN)); then
        n_skipped=$((n_skipped + 1))
        # Held back rather than printed here, so the count comes first and a
        # -a listing reads as an explanation of it.
        if [[ -n $SHOW_ALL ]]; then
          fmt_age $((HIST_NOW - HIST_TS))
          sk_show="$sk_show$(printf '  %4d. %-22s %s' "${idx[$((k - 1))]}" \
            "$(batch_label "$su")" "${D}skipped — $HIST_VERDICT $AGE${N}")
"
        fi
        continue
      fi
      sk_urls+=("$su")
      sk_idx+=("${idx[$((k - 1))]}")
    done
    urls=(${sk_urls[@]+"${sk_urls[@]}"})
    idx=(${sk_idx[@]+"${sk_idx[@]}"})
    ((n_skipped == 0)) ||
      echo "${D}skipping ${n_skipped} line(s) a run in the last ${SKIP_SPEC} found dead or expired${N}"
    [[ -z $sk_show ]] || printf '%s' "$sk_show"
    ((${#urls[@]})) || {
      echo "${D}── nothing left to check (-r rechecks them all)${N}"
      return
    }
  fi

  # Pass our own -t/-r flags through to each sub-invocation. Batch lines fail
  # fast on a dead host — no point waiting the full single-line connect budget.
  local -a fwd=(-c "$BATCH_CONNECT_TIMEOUT")
  [[ -z $STATS ]] && fwd+=(-T "$BATCH_TIMEOUT")
  [[ -n $CATQ ]] && fwd+=(-C "$CATQ")
  [[ -n $MUST ]] && fwd+=(-m "$MUST")
  [[ -n $TZQ ]] && fwd+=(-z "$TZQ")
  [[ $KIND != live ]] && fwd+=(-t "$KIND")
  [[ -n $REFRESH ]] && fwd+=(-r)

  local total=${#urls[@]}
  batch_autoscale "$total"
  echo "${D}${total} line(s) · running '$sub' · ${BATCH_CONCURRENCY} at a time${JOBS_SET:+ (-j)}${N}"

  # Run the lines concurrently, each into its own temp file, keeping the slots
  # topped up rather than waiting for a whole round to drain — one slow line
  # then costs one slot, not the whole batch. Results are rendered in order as
  # they land, so a run over thousands of lines shows rows all the way through
  # instead of nothing until the end.
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/xtream-batch.XXXXXX")"
  local i=0 r=0 k
  local n_active=0 n_expired=0 n_dead=0 n_dup=0
  local seen_hosts=" "
  local -a rank_keys=()
  local streaming=""
  [[ $sub == status || $sub == counts || $sub == playable ]] && streaming=1

  # In-flight workers, tracked by hand. `jobs` cannot do it: a command
  # substitution runs in a subshell with an empty job table, so `$(jobs -pr)`
  # always came back empty and every line launched at once — a few thousand
  # processes against a 4000 cap, which is where "fork: Resource temporarily
  # unavailable" came from. A worker is finished when its .done file appears;
  # both tests below are builtins, so polling costs no processes at all.
  local -a live_idx=() live_pid=() keep_idx=() keep_pid=()

  while ((r < total)); do
    while ((i < total)) && ((${#live_idx[@]} < BATCH_CONCURRENCY)); do
      i=$((i + 1))
      (
        batch_run_line "${urls[$((i - 1))]}" "$@" >"$tmp/$i.out" 2>&1 || true
        mv -f "$tmp/$i.out" "$tmp/$i.done"
      ) &
      live_idx+=("$i")
      live_pid+=("$!")
    done

    keep_idx=(); keep_pid=()
    for k in ${live_idx[@]+"${!live_idx[@]}"}; do
      if [[ -e $tmp/${live_idx[$k]}.done ]]; then
        continue
      elif ! kill -0 "${live_pid[$k]}" 2>/dev/null; then
        # Gone without leaving a result — a worker that could not start, or
        # was killed. Record the empty answer so the run isn't stuck on it.
        : >"$tmp/${live_idx[$k]}.done"
        continue
      fi
      keep_idx+=("${live_idx[$k]}")
      keep_pid+=("${live_pid[$k]}")
    done
    live_idx=(${keep_idx[@]+"${keep_idx[@]}"})
    live_pid=(${keep_pid[@]+"${keep_pid[@]}"})

    while ((r < total)) && [[ -e $tmp/$((r + 1)).done ]]; do
      r=$((r + 1))
      case "$sub" in
      status) render_status_row "$r" ;;
      counts) render_counts_row "$r" ;;
      playable) render_playable_row "$r" ;;
      esac
    done

    if ((r < total)); then
      batch_progress "$r" "$total"
      sleep 0.2
    fi
  done
  for k in ${live_pid[@]+"${live_pid[@]}"}; do wait "$k" 2>/dev/null || true; done
  batch_progress_clear

  local retried=0
  retried="$(ls "$tmp" 2>/dev/null | grep -c '\.retry$' || true)"

  local out sig n user host

  # The winners, best first. Built from the result files, which is why this
  # runs before the temp directory goes away.
  if [[ $sub == playable ]] && ((${#rank_keys[@]})); then
    local rank=0 rk_pos
    echo
    echo "${D}── best first${N}"
    while read -r _ _ rk_pos; do
      [[ -n $rk_pos ]] || continue
      rank=$((rank + 1))
      render_playable_detail "$rank" "$rk_pos"
    done < <(printf '%s\n' "${rank_keys[@]}" | sort -k1,1nr -k2,2nr)
  fi

  # status/counts rows have already streamed out; close with the tallies.
  if [[ -n $streaming ]]; then
    echo
    if [[ $sub == status ]]; then
      echo "${D}── $total lines · ${n_active} active · ${n_expired} expired/blocked · ${n_dead} dead${N}"
    elif [[ $sub == playable ]]; then
      echo "${D}── $total lines · ${n_active} play · ${n_expired} refused · ${n_dead} dead${N}"
      ((n_dup == 0)) || echo "${D}   ${n_dup} of those repeat a server already listed${N}"
    else
      echo "${D}── $total lines · ${n_active} answered · ${n_dead} dead${N}"
    fi
    [[ -n $SHOW_ALL ]] || ((n_expired + n_dead == 0)) ||
      echo "${D}   $((n_expired + n_dead)) line(s) not shown — -a lists them too${N}"
    ((n_skipped == 0)) ||
      echo "${D}   ${n_skipped} more skipped as known dead/expired — -r rechecks them${N}"
    ((retried)) && echo "${D}   retried $retried rate-limited line(s)${N}"
    rm -rf "$tmp"
    return
  fi

  ((retried)) && echo "${D}retried $retried rate-limited line(s)${N}"

  # Group byte-identical results (a shared server repeats the same catalogue
  # under every account), classify each line, and tally for the summary.
  local -a g_sig=() g_label=() g_host=() g_out=() g_cat=() g_also=() err_labels=()
  local n_ok=0 n_empty=0 n_err=0 cat gi u
  for i in $(seq 1 "$total"); do
    u="${urls[$((i - 1))]}"
    n="${idx[$((i - 1))]}"
    # Braces are load-bearing: bash 3.2 reads the bytes of "·" as part of the
    # variable name in a bare "$n·".
    user="${n}·$(batch_label "$u")"
    host="${u#*://}"; host="${host%%/*}"
    out="$(cat "$tmp/$i.done" 2>/dev/null)"
    sig="$(printf '%s' "$out" | hash_text)"

    if grep -qE 'curl: \(|request failed|server rejected|timed out|authentication rejected|no channel list' <<<"$out"; then
      cat=ERR; n_err=$((n_err + 1)); err_labels+=("$user")
      history_note "$u" dead unreachable
    elif [[ -z ${out//[[:space:]]/} ]] || grep -q 'no live channel matches' <<<"$out"; then
      cat=EMPTY; n_empty=$((n_empty + 1))
      history_note "$u" alive "no match"
    else
      cat=OK; n_ok=$((n_ok + 1))
      history_note "$u" alive answered
    fi

    gi=-1
    for k in ${g_sig[@]+"${!g_sig[@]}"}; do
      [[ ${g_sig[$k]} == "$sig" ]] && gi=$k && break
    done
    if ((gi < 0)); then
      g_sig+=("$sig"); g_label+=("$user"); g_host+=("$host")
      g_out+=("$out"); g_cat+=("$cat"); g_also+=("")
    else
      g_also[$gi]="${g_also[$gi]} $user"
    fi
  done

  local also code
  for k in ${g_sig[@]+"${!g_sig[@]}"}; do
    cat="${g_cat[$k]}"
    # For search, a "no match" line is just noise — count it, don't print it.
    [[ $sub == search && $cat == EMPTY ]] && continue
    [[ $cat == ERR && -z $SHOW_ALL ]] && continue
    also="${g_also[$k]# }"
    echo
    case "$cat" in
    OK)
      echo "${B}${g_host[$k]} · ${g_label[$k]}${N}"
      printf '%s\n' "${g_out[$k]}" | sed 's/^/  /'
      ;;
    EMPTY)
      echo "${B}${g_host[$k]} · ${g_label[$k]}${N} ${D}— no match${N}"
      ;;
    ERR)
      # `|| true`: a connection-refused error carries no numeric code, so the
      # grep pipeline exits non-zero, which under set -e would kill the render.
      code="$(grep -oE '(error: |HTTP )[0-9]{3}' <<<"${g_out[$k]}" | grep -oE '[0-9]{3}' | head -1 || true)"
      echo "${B}${g_host[$k]} · ${g_label[$k]}${N} ${R}⚠ $([[ -n $code ]] && echo "HTTP $code" || echo error)${N}"
      ;;
    esac
    [[ -n $also ]] && echo "  ${D}also: ${also// /, }${N}"
  done

  echo
  echo "${D}── $total lines · ${n_ok} matched · ${n_empty} no match · ${n_err} dead${N}"
  ((n_skipped == 0)) ||
    echo "${D}   ${n_skipped} more skipped as known dead/expired — -r rechecks them${N}"
  if ((n_err)); then
    # Naming every dead line is unreadable once a dump runs to thousands.
    local joined="" shown=0
    for k in "${err_labels[@]}"; do
      ((shown < 20)) || { joined="$joined, … and $((n_err - shown)) more"; break; }
      joined="${joined:+$joined, }$k"
      shown=$((shown + 1))
    done
    echo "${D}   dead: ${joined}${N}"
  fi

  rm -rf "$tmp"
}

# Ad-hoc URLs get their own cache slot so repeated tests of different
# providers never read each other's channel lists.
adhoc_profile_key() {
  local raw="${XTREAM_HOST#*://}_${XTREAM_USER}"
  # printf, not a herestring: the trailing newline would become an underscore.
  printf 'adhoc.%s' "$(printf '%s' "$raw" | tr -c '[:alnum:]._-' '_')"
}

load_config() {
  # An explicit URL bypasses profiles entirely — the common case here is
  # "does this playlist someone just sent me work at all?".
  if [[ -n ${URL_OVERRIDE:-} ]]; then
    # Stalker portal token: stalker:<portal>#<mac>
    if [[ $URL_OVERRIDE == stalker:* ]]; then
      local rest="${URL_OVERRIDE#stalker:}"
      STALKER=1
      STALKER_PORTAL="${rest%%#*}"
      STALKER_MAC="${rest#*#}"
      [[ -n $STALKER_MAC && $STALKER_MAC != "$rest" ]] || die "bad stalker token (need portal#mac)"
      PROFILE="stalker.$(printf '%s' "${STALKER_PORTAL#*://}_${STALKER_MAC}" | tr -c '[:alnum:]' '_')"
      return
    fi
    parse_playlist_url "$URL_OVERRIDE"
    XTREAM_HOST="${XTREAM_HOST%/}"
    PROFILE="$(adhoc_profile_key)"
    return
  fi

  local env_host="${XTREAM_HOST:-}" env_user="${XTREAM_USER:-}" env_pass="${XTREAM_PASS:-}"
  local conf="$CONFIG_DIR/$PROFILE.conf"

  if [[ -r $conf ]]; then
    # shellcheck disable=SC1090
    source "$conf"
  elif [[ -z $env_host || -z $env_user || -z $env_pass ]]; then
    die "no credentials — create $conf (see 'xtream --help')"
  fi

  # Environment wins over the file.
  [[ -n $env_host ]] && XTREAM_HOST="$env_host"
  [[ -n $env_user ]] && XTREAM_USER="$env_user"
  [[ -n $env_pass ]] && XTREAM_PASS="$env_pass"

  : "${XTREAM_HOST:?missing XTREAM_HOST}"
  : "${XTREAM_USER:?missing XTREAM_USER}"
  : "${XTREAM_PASS:?missing XTREAM_PASS}"

  XTREAM_HOST="$(resolve_secret "$XTREAM_HOST")"
  XTREAM_USER="$(resolve_secret "$XTREAM_USER")"
  XTREAM_PASS="$(resolve_secret "$XTREAM_PASS")"

  [[ $XTREAM_HOST == http://* || $XTREAM_HOST == https://* ]] || XTREAM_HOST="http://$XTREAM_HOST"
  XTREAM_HOST="${XTREAM_HOST%/}"
}

resolve_secret() {
  if [[ $1 == op://* ]]; then
    command -v op >/dev/null 2>&1 || die "1Password CLI (op) not found, needed for $1"
    op read "$1"
  else
    printf '%s' "$1"
  fi
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# --------------------------------------------------------------------- api ---

api() {
  local action="${1:-}"
  local -a args=(
    --get
    --data-urlencode "username=$XTREAM_USER"
    --data-urlencode "password=$XTREAM_PASS"
  )
  [[ -n $action ]] && args+=(--data-urlencode "action=$action")

  local resp rc=0
  resp="$(curl -fsS \
    --connect-timeout "$CONNECT_TIMEOUT" \
    --max-time "$TIMEOUT" \
    --speed-limit "$SPEED_LIMIT" --speed-time "$SPEED_TIME" \
    --compressed \
    "${args[@]}" "$XTREAM_HOST/player_api.php")" || rc=$?

  if ((rc != 0)); then
    case $rc in
    28) die "timed out after ${TIMEOUT}s${action:+ fetching $action} — this panel is slow or huge; retry with XTREAM_TIMEOUT=900" ;;
    6) die "cannot resolve host in $XTREAM_HOST" ;;
    7) die "cannot connect to $XTREAM_HOST" ;;
    22) die "server rejected the request (HTTP error) at $XTREAM_HOST" ;;
    *) die "request failed (curl exit $rc) — $XTREAM_HOST" ;;
    esac
  fi

  # A rejected line still answers HTTP 200, with {"user_info":{"auth":0}}.
  if jq -e 'type == "object" and (.user_info.auth? == 0)' >/dev/null 2>&1 <<<"$resp"; then
    die "authentication rejected — check the credentials for profile '$PROFILE'"
  fi

  printf '%s' "$resp"
}

mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1"; }

# Portable content hash for dedup: shasum on macOS, sha1sum on most Linux,
# cksum as a last resort. Only stability matters, not the algorithm.
hash_text() {
  if command -v shasum >/dev/null 2>&1; then shasum
  elif command -v sha1sum >/dev/null 2>&1; then sha1sum
  else cksum; fi | cut -d' ' -f1
}

# Align a TSV on stdin into columns, falling back to raw output where
# `column` is missing (e.g. a minimal Git Bash on Windows).
tabulate() {
  if command -v column >/dev/null 2>&1; then column -t -s "$(printf '\t')"
  else cat; fi
}

# Cached GET for the big list endpoints.
api_cached() {
  local action="$1"
  local file="$CACHE_DIR/${PROFILE}.${action}.json"

  if [[ -z $REFRESH && -s $file ]]; then
    local age=$(($(date +%s) - $(mtime "$file")))
    if ((age < CACHE_TTL)); then
      cat "$file"
      return
    fi
  fi

  # These payloads run to tens of megabytes on large panels; say what is
  # happening so a slow first fetch does not look like a hang.
  [[ -t 2 ]] && printf '%s' "${D}fetching ${action#get_}…${N}" >&2

  # Fetch into memory first, so a failed request never leaves a stray .tmp
  # (api() dies on error, which would skip any cleanup after a redirect).
  local data
  data="$(api "$action")" || exit 1

  [[ -t 2 ]] && printf '\r\033[2K' >&2

  mkdir -p "$CACHE_DIR"
  printf '%s' "$data" >"$file.tmp" && mv -f "$file.tmp" "$file"
  printf '%s' "$data"
}

streams_action() {
  case "$KIND" in
  live) echo get_live_streams ;;
  vod) echo get_vod_streams ;;
  series) echo get_series ;;
  *) die "unknown type '$KIND' (use live, vod or series)" ;;
  esac
}

categories_action() {
  case "$KIND" in
  live) echo get_live_categories ;;
  vod) echo get_vod_categories ;;
  series) echo get_series_categories ;;
  esac
}

# id<TAB>name<TAB>category, optionally filtered by a case-insensitive regex.
list_streams() {
  local query="${1:-}"
  local cats streams

  # `|| exit 1` on every capture: die() runs inside these substitutions, and
  # without it the caller would sail on and fire the next request anyway.
  cats="$(api_cached "$(categories_action)")" || exit 1
  streams="$(api_cached "$(streams_action)")" || exit 1

  # A dead/misbehaving line can answer HTTP 200 with a non-JSON error page.
  # Validate before jq, so the user sees a clean message instead of jq's
  # "invalid JSON text passed to --argjson".
  jq -e . >/dev/null 2>&1 <<<"$streams" || die "line returned no channel list (rejected or offline)"
  jq -e . >/dev/null 2>&1 <<<"$cats" || cats="[]"

  jq -r --arg q "$query" --arg cq "$CATQ" --argjson cats "$cats" '
    ($cats | map({key: (.category_id | tostring), value: .category_name}) | from_entries) as $cmap
    | .[]
    | . as $s
    | (($cmap[($s.category_id | tostring)]) // "-") as $cname
    # A query matches the name or the category: half these panels file the
    # British football under SPORTS and put UK in the channel name, the other
    # half do the reverse. -C stays category-only for when that is exactly
    # what you mean.
    | select($q == "" or ($s.name | test($q; "i")) or ($cname | test($q; "i")))
    | select($cq == "" or ($cname | test($cq; "i")))
    | [ ($s.stream_id // $s.series_id // $s.num | tostring), $s.name, $cname ]
    | @tsv
  ' <<<"$streams"
}

stream_url() {
  local id="$1"
  case "$KIND" in
  live) printf '%s/live/%s/%s/%s.ts' "$XTREAM_HOST" "$XTREAM_USER" "$XTREAM_PASS" "$id" ;;
  vod)
    local vod ext
    vod="$(api_cached get_vod_streams)" || exit 1
    ext="$(jq -r --arg id "$id" '
      [.[] | select((.stream_id|tostring) == $id) | .container_extension // "mp4"][0] // "mp4"' <<<"$vod")"
    printf '%s/movie/%s/%s/%s.%s' "$XTREAM_HOST" "$XTREAM_USER" "$XTREAM_PASS" "$id" "${ext:-mp4}"
    ;;
  series) die "series are containers, not streams — pick an episode in a full client" ;;
  esac
}

# Accept a numeric id as-is; otherwise resolve a query to exactly one id.
resolve_id() {
  local arg="$1"
  if [[ $arg =~ ^[0-9]+$ ]]; then
    printf '%s' "$arg"
    return
  fi

  local matches count
  matches="$(list_streams "$arg")" || exit 1
  count="$(grep -c . <<<"$matches" || true)"

  case "$count" in
  0) die "no $KIND channel matches '$arg'" ;;
  1) cut -f1 <<<"$matches" ;;
  *)
    # Only reach for fzf when there is a terminal to drive it — otherwise a
    # scripted or piped call hangs forever on an invisible picker.
    if [[ -t 0 && -t 2 ]] && command -v fzf >/dev/null 2>&1; then
      cut -f1 <<<"$(fzf --with-nth=2.. --delimiter='\t' --prompt="$KIND> " <<<"$matches")"
    else
      echo "${Y}$count matches for '$arg'${N} — narrow it down or pass an id:" >&2
      tabulate <<<"$matches" >&2
      exit 1
    fi
    ;;
  esac
}

# ---------------------------------------------------------------- commands ---

cmd_status() {
  if [[ -n ${STALKER:-} ]]; then
    local sout server mac st exp days
    sout="$(stalker_run status)" || exit 1
    server="$(sed -n 's/^server *//p' <<<"$sout")"
    mac="$(sed -n 's/^mac *//p' <<<"$sout")"
    st="$(sed -n 's/^status *//p' <<<"$sout")"
    exp="$(sed -n 's/^expires *//p' <<<"$sout")"
    local col="$Y"
    [[ $st == Active ]] && col="$G"
    [[ $st == Expired ]] && col="$R"
    printf '%-13s%s\n' profile "${D}(stalker portal)${N}"
    printf '%-13s%s\n' server "$server"
    printf '%-13s%s\n' mac "$mac"
    printf '%-13s%s\n' status "${col}${st}${N}"
    [[ -n $exp ]] && printf '%-13s%s\n' expires "$exp"
    days="$(sed -n 's/.*(\(-*[0-9]*\) days).*/\1/p' <<<"$exp")"
    if [[ $days =~ ^-?[0-9]+$ ]]; then
      if ((days < 0)); then echo "${R}✗ line expired${N}"
      elif ((days <= 7)); then echo "${Y}! expires in $days day(s)${N}"; fi
    fi
    return
  fi

  # One field per line: bash collapses runs of tabs when IFS is whitespace,
  # so a TSV row with an empty field would silently shift every column.
  # Built with a read loop rather than mapfile — macOS ships bash 3.2.
  local -a f=()
  local line
  while IFS= read -r line; do f+=("$line"); done < <(
    api | jq -r '
      def nz: if . == null or . == "" then "-" else (. | tostring) end;
      def human(ts):
        if ts == null or ts == "" then "never"
        else (ts | tonumber | localtime | strftime("%Y-%m-%d %H:%M")) end;

      .user_info as $u | .server_info as $s |
      ($u.status | nz),
      ($u.username | nz),
      human($u.exp_date),
      ($u.exp_date | nz),
      (if ($u.is_trial // "0") == "1" then "yes" else "no" end),
      ($u.active_cons | nz),
      ($u.max_connections | nz),
      ($s.timezone | nz)
    '
  )

  local status="${f[0]}" username="${f[1]}" expires="${f[2]}" exp_ts="${f[3]}"
  local trial="${f[4]}" active="${f[5]}" maxcons="${f[6]}" tz="${f[7]}"

  local status_color="$Y"
  [[ $status == Active ]] && status_color="$G"
  [[ $status == Expired || $status == Banned || $status == Disabled ]] && status_color="$R"

  local left="" days=""
  if [[ $exp_ts =~ ^[0-9]+$ ]]; then
    left=$((exp_ts - $(date +%s)))
    # Round up: a line dying in 2h51m still reads as "1 day", not "0".
    ((left >= 0)) && days=$(((left + 86399) / 86400)) || days=$((left / 86400))
    expires="$expires  ${D}($days days)${N}"
  fi

  if [[ -n ${URL_OVERRIDE:-} ]]; then
    printf '%-13s%s\n' profile "${D}(ad-hoc URL — 'xtream … save NAME' to keep it)${N}"
  else
    printf '%-13s%s\n' profile "$PROFILE"
  fi
  printf '%-13s%s\n' server "$XTREAM_HOST"
  printf '%-13s%s\n' username "$username"
  printf '%-13s%s\n' status "${status_color}${status}${N}"
  printf '%-13s%s\n' expires "$expires"
  printf '%-13s%s\n' trial "$trial"
  printf '%-13s%s\n' connections "$active / $maxcons"
  printf '%-13s%s\n' timezone "$tz"

  # Loud warning when the line is close to the wire.
  if [[ -n $left ]]; then
    if ((left < 0)); then
      echo "${R}✗ line expired${N}"
    elif ((days <= 7)); then
      echo "${Y}! expires in $days day(s)${N}"
    fi
  fi
}

# counts [live|movies|series ...] — each catalogue is a separate full
# download, so being able to ask for only the ones you want is the difference
# between one request and three on a big panel.
cmd_counts() {
  if [[ -n ${STALKER:-} ]]; then
    stalker_run counts
    return
  fi
  local -a want=()
  local a data
  for a in "$@"; do
    case "$a" in
    live | movies | series) want+=("$a") ;;
    *) die "usage: xtream counts [live|movies|series ...]" ;;
    esac
  done
  ((${#want[@]})) || want=(live movies series)

  for a in "${want[@]}"; do
    case "$a" in
    live)
      data="$(api_cached get_live_streams)" || exit 1
      printf 'live    %s\n' "$(jq 'length' <<<"$data")" ;;
    movies)
      data="$(api_cached get_vod_streams)" || exit 1
      printf 'movies  %s\n' "$(jq 'length' <<<"$data")" ;;
    series)
      data="$(api_cached get_series)" || exit 1
      printf 'series  %s\n' "$(jq 'length' <<<"$data")" ;;
    esac
  done
}

cmd_search() {
  local out
  if [[ -n ${STALKER:-} ]]; then
    out="$(stalker_run search "${1:-}")" || exit 1
  else
    out="$(list_streams "${1:-}")" || exit 1
    if [[ -z $out ]]; then
      local msg="no $KIND channel matches"
      [[ -n ${1:-} ]] && msg="$msg '$1'"
      [[ -n $CATQ ]] && msg="$msg in a category like /$CATQ/"
      die "$msg"
    fi
  fi
  if [[ -n $ISATTY ]]; then
    tabulate <<<"$out"
  else
    printf '%s\n' "$out"
  fi
}

cmd_categories() {
  local out
  out="$(api_cached "$(categories_action)")" || exit 1
  out="$(jq -r '.[] | [.category_id, .category_name] | @tsv' <<<"$out")"
  if [[ -n $ISATTY ]]; then
    tabulate <<<"$out"
  else
    printf '%s\n' "$out"
  fi
}

cmd_url() {
  [[ -n ${1:-} ]] || die "usage: xtream url <ID|QUERY>"
  if [[ -n ${STALKER:-} ]]; then
    stalker_run url "$1" || exit 1
    return
  fi
  local id
  id="$(resolve_id "$1")" || exit 1
  stream_url "$id"
  echo
}

# play <ID|QUERY> — an id plays straight away, a query that matches one
# channel does too, and only a genuine choice opens the picker.
cmd_play() {
  need mpv
  local list pick id url name

  if [[ ${1:-} =~ ^[0-9]+$ ]]; then
    id="$1"
    name="stream $1"
  else
    if [[ -n ${STALKER:-} ]]; then
      list="$(stalker_run search "${1:-}")" || exit 1
    else
      list="$(list_streams "${1:-}")" || exit 1
      [[ -n $list ]] || die "no $KIND channel matches '${1:-}'"
    fi

    if [[ $(grep -c . <<<"$list") -eq 1 ]]; then
      pick="$list"
    else
      need fzf
      [[ -t 0 ]] || die "several channels match — pass a stream id, or run this in a terminal to pick one"
      pick="$(fzf --with-nth=2.. --delimiter='\t' --prompt="stream> " <<<"$list" || true)"
      [[ -n $pick ]] || exit 0
    fi
    id="$(cut -f1 <<<"$pick")"
    name="$(cut -f2 <<<"$pick")"
  fi

  if [[ -n ${STALKER:-} ]]; then
    url="$(stalker_run url "$id")" || exit 1
  else
    url="$(stream_url "$id")" || exit 1
  fi

  # A refused stream would otherwise be a player that opens and closes with
  # nothing said — the panel's reason is the useful part.
  http_probe_stream "$url" "$id" || exit 1

  echo "${B}▶${N} $name"
  local rc=0
  mpv --quiet "$url" || rc=$?
  if ((rc != 0)); then
    echo "${R}✗ mpv exited $rc${N} — the panel let the request through but the stream did not play" >&2
    echo "  ${D}xtream … check $id  says what the stream itself is doing${N}" >&2
    exit 1
  fi
}

# Ask the server about a stream before a player or ffprobe touches it: both
# turn a panel's refusal into either silence or "4XX Client Error, but not one
# of 40{0,1,3,4}", which says nothing. Prints the verdict; non-zero when the
# panel is refusing.
http_probe_stream() {
  local url="$1" id="$2" quiet="${3:-}" probe code redir

  # -L: panels commonly answer with a 302 to a tokenised URL on another host,
  # and the status that matters is the one at the end of that chain.
  probe="$(curl -sL --max-redirs 5 -o /dev/null -w '%{http_code} %{url_effective}' \
    --connect-timeout "$CONNECT_TIMEOUT" --max-time 10 -r 0-1024 "$url" 2>/dev/null || true)"
  code="${probe%% *}"
  redir="${probe#* }"
  PROBE_CODE="$code"
  PROBE_REASON=""

  # Panels answer dead channels with a placeholder clip instead of an error,
  # so a player shows it happily and the channel looks alive. The redirect
  # target is what gives it away.
  case "$redir" in
  *offline* | *no_signal* | *nosignal* | *not_available* | *comingsoon*)
    PROBE_REASON="placeholder"
    [[ -n $quiet ]] && return 1
    echo "${Y}⚠ stream $id is a placeholder, not live${N}"
    echo "  the panel sends you to ${redir##*/} — the channel is listed but off air"
    return 1
    ;;
  esac

  case "$code" in
  2* | 3* | "") return 0 ;;
  000)
    PROBE_REASON="no response"
    [[ -n $quiet ]] && return 1
    echo "${R}✗ no response from $XTREAM_HOST for stream $id${N}"
    return 1
    ;;
  esac

  PROBE_REASON="HTTP $code"
  [[ -n $quiet ]] && return 1
  echo "${R}✗ stream $id refused by the server (HTTP $code)${N}"
  # Panels front themselves with proxies that invent status codes. These are
  # the ones seen in the wild; 456 and 458 in particular are decided per
  # account, before the channel is even looked up.
  case "$code" in
  456 | 458) echo "  $code — the panel refuses this account for playback (blocked line, or a geo/IP restriction). Same code for every channel, including ids that don't exist" >&2 ;;
  401) echo "  401 — the line authenticates against the API but is not allowed to play. Usually a reseller line sold for listing only, or one bound to another IP/device. Same code for every channel" >&2 ;;
  403) echo "  403 — rejected for playback, though the API accepted the line. Also what these panels answer while an earlier connection of yours is still counted" >&2 ;;
  404) echo "  404 — no such stream id" >&2 ;;
  451) echo "  451 — blocked for legal or geographic reasons at the panel's CDN" >&2 ;;
  509 | 512) echo "  connection limit reached — check 'connections' in xtream status" >&2 ;;
  513) echo "  513 — the panel does not recognise these credentials" >&2 ;;
  884) echo "  884 — playlist/stream download blocked by the panel's CDN proxy" >&2 ;;
  esac
  return 1
}

# playable [QUERY] — does this line actually stream anything? Takes the first
# channel it lists (honouring -C / QUERY, so you can ask about the channels
# you care about) and asks the panel for it. A line can sit there Active with
# 20,000 channels and refuse every one of them.
cmd_playable() {
  local q="${1:-}" list names row id name url matches purl sample
  local must_ok=0 must_total=0 missing="" tok
  local info st exp cons tz alias

  # One small request first. It says whether the line is alive, when it dies,
  # how many connections it allows and where the server thinks it lives — all
  # the cheap reasons to drop a line before pulling megabytes of catalogue.
  if [[ -z ${STALKER:-} ]]; then
    info="$(api 2>/dev/null || true)"
    if [[ -n $info ]]; then
      st="$(jq -r '.user_info.status // ""' <<<"$info" 2>/dev/null || true)"
      exp="$(jq -r 'if (.user_info.exp_date // "") == "" then "never"
                    else (.user_info.exp_date | tonumber | localtime | strftime("%Y-%m-%d")) end' <<<"$info" 2>/dev/null || true)"
      cons="$(jq -r '"\(.user_info.active_cons // "-")/\(.user_info.max_connections // "-")"' <<<"$info" 2>/dev/null || true)"
      tz="$(jq -r '.server_info.timezone // ""' <<<"$info" 2>/dev/null || true)"
      # Panels report the address they call themselves, which is often a name
      # where the dump has a bare IP — one less thing to spell out on a remote.
      alias="$(jq -r '(.server_info.url // "") as $h | (.server_info.port // "" | tostring) as $p
                      | if $h == "" then "" elif $p == "" then $h else $h + ":" + $p end' <<<"$info" 2>/dev/null || true)"
    fi
    [[ -n ${exp:-} ]] && echo "expires   $exp"
    [[ -n ${cons:-} ]] && echo "conns     $cons"
    [[ -n ${tz:-} ]] && echo "tz        $tz"

    if [[ -n $TZQ ]]; then
      if [[ -z ${tz:-} ]] || ! grep -qiE "$TZQ" <<<"$tz"; then
        echo "playable  no"
        echo "reason    tz ${tz:-unknown}"
        return 1
      fi
    fi
    if [[ -n ${st:-} && $st != Active ]]; then
      echo "playable  no"
      echo "reason    $st"
      return 1
    fi
  fi

  if [[ -n ${STALKER:-} ]]; then
    list="$(stalker_run search "$q")" || exit 1
  else
    list="$(list_streams "$q")" || exit 1
  fi

  if [[ -z $list ]]; then
    echo "playable  no"
    echo "reason    no matching channel"
    return 1
  fi

  matches="$(grep -c . <<<"$list" || true)"
  # name and category together: "SKY" may be the name (SKY SPORTS UK HD) or
  # the category (UK SPORTS / SKY CHANNELS).
  names="$(cut -f2- <<<"$list")"

  # -m: the channels that make a line worth having. Checked before anything
  # is streamed — a line without them is not worth the probe.
  if [[ -n $MUST ]]; then
    while IFS= read -r tok; do
      [[ -n $tok ]] || continue
      must_total=$((must_total + 1))
      if grep -qiE "$tok" <<<"$names"; then
        must_ok=$((must_ok + 1))
      else
        missing="${missing:+$missing, }$tok"
      fi
    done < <(printf '%s\n' "$MUST" | tr ',' '\n')
  fi

  echo "matches   $matches"
  ((must_total == 0)) || echo "must      $must_ok/$must_total"
  # What it carries, by category and size. Eight channel names off the top of
  # the list say nothing — 1267 matches split as "UK ENTERTAINMENT 620 ·
  # UK SPORTS 210" tells you at a glance whether the sport is in there.
  sample="$(cut -f3 <<<"$list" | sort | uniq -c | sort -rn | head -6 |
    awk '{ n = $1; $1 = ""; gsub(/[^[:print:]]/, ""); gsub(/  +/, " ");
           sub(/^ +/, ""); sub(/ +$/, "");
           printf "%s%s %s", sep, substr($0, 1, 34), n; sep = " · " }')"
  echo "sample    $sample"

  if ((must_total > 0)) && ((must_ok < must_total)); then
    echo "playable  no"
    echo "reason    missing $missing"
    return 1
  fi

  row="$(head -1 <<<"$list")"
  id="$(cut -f1 <<<"$row")"
  name="$(cut -f2 <<<"$row")"

  if [[ -n ${STALKER:-} ]]; then
    url="$(stalker_run url "$id")" || exit 1
    purl="stalker:${STALKER_PORTAL}#${STALKER_MAC}"
  else
    url="$(stream_url "$id")" || exit 1
    purl="${URL_OVERRIDE:-$XTREAM_HOST/get.php?username=$XTREAM_USER&password=$XTREAM_PASS&type=m3u_plus}"
  fi

  if http_probe_stream "$url" "$id" quiet; then
    echo "playable  yes"
    echo "channel   $id  $name"
    echo "url       $purl"
    # A TV asks for server/username/password separately, which is a lot less
    # typing on a remote than the whole URL — and these are decoded, so a
    # password written %40 in the dump is the @ you actually have to type.
    if [[ -z ${STALKER:-} ]]; then
      echo "server    $XTREAM_HOST"
      echo "user      $XTREAM_USER"
      echo "pass      $XTREAM_PASS"
      [[ -n ${alias:-} && ${XTREAM_HOST#*://} != "$alias" ]] && echo "alias     $alias"
    fi
    return 0
  fi
  echo "playable  no"
  echo "channel   $id  $name"
  echo "reason    ${PROBE_REASON:-refused}"
  return 1
}

cmd_check() {
  need ffprobe
  [[ -n ${1:-} ]] || die "usage: xtream check <ID|QUERY>"

  local id url info errlog rc=0 tracks
  if [[ -n ${STALKER:-} ]]; then
    id="$1"
    url="$(stalker_run url "$1")" || exit 1
  else
    id="$(resolve_id "$1")" || exit 1
    url="$(stream_url "$id")" || exit 1
  fi

  http_probe_stream "$url" "$id" || exit 1

  # Keep stderr out of the JSON: decoders happily log warnings at error level
  # ("non-existing SPS 0 referenced...") on perfectly playable streams.
  errlog="$(mktemp "${TMPDIR:-/tmp}/xtream.XXXXXX")"

  # -show_streams, not -show_entries stream=...: the latter also walks the
  # programs section of a .ts and reports every stream twice.
  info="$(ffprobe -v error -print_format json -show_streams \
    -timeout "$((PROBE_TIMEOUT * 1000000))" "$url" 2>"$errlog")" || rc=$?

  tracks="$(jq -r '.streams | length' <<<"${info:-}" 2>/dev/null || echo 0)"

  # The probe above opened a connection, and panels keep counting it for a few
  # seconds after it closes — on a line capped at 1 or 2 that alone is enough
  # to make the very next request fail. One retry, once the slot has cleared,
  # before calling a stream dead.
  if ((rc != 0)) || [[ ${tracks:-0} -eq 0 ]]; then
    [[ -n $ISATTY ]] && echo "${D}retrying — the panel may still be counting the probe connection${N}" >&2
    sleep 4
    rc=0
    info="$(ffprobe -v error -print_format json -show_streams \
      -timeout "$((PROBE_TIMEOUT * 1000000))" "$url" 2>"$errlog")" || rc=$?
    tracks="$(jq -r '.streams | length' <<<"${info:-}" 2>/dev/null || echo 0)"
  fi

  if ((rc != 0)) || [[ ${tracks:-0} -eq 0 ]]; then
    echo "${R}✗ stream $id is not playing${N}"
    sed 's/^/  /' "$errlog" >&2
    [[ ${tracks:-0} -eq 0 && $rc -eq 0 ]] && echo "  ffprobe found no audio/video tracks" >&2
    rm -f "$errlog"
    exit 1
  fi

  echo "${G}✓ stream $id is live${N}"
  jq -r '
    def fps: (.r_frame_rate // "0/1" | split("/")
              | if (.[1] | tonumber) == 0 then 0
                else ((.[0] | tonumber) / (.[1] | tonumber)) end
              | . * 100 | round / 100);
    .streams[]
    # Multi-program transport streams list phantom 0x0 / 0-channel tracks
    # alongside the real one; drop them so the summary shows what plays.
    | select(
        (.codec_type == "video" and (.width // 0) > 0) or
        (.codec_type == "audio" and (.channels // 0) > 0) or
        (.codec_type != "video" and .codec_type != "audio")
      )
    | if .codec_type == "video" then
        "  video  \(.codec_name)  \(.width)x\(.height)  \(fps)fps"
      elif .codec_type == "audio" then
        "  audio  \(.codec_name)  \(.channels // "?")ch  \(.sample_rate // "?")Hz"
      else
        "  \(.codec_type)  \(.codec_name)"
      end
  ' <<<"$info" | awk '!seen[$0]++'

  # Surface decoder complaints without calling the stream dead.
  if [[ -s $errlog ]]; then
    echo "  ${D}$(wc -l <"$errlog" | tr -d ' ') decoder warning(s) — stream still decodes${N}"
  fi
  rm -f "$errlog"
}

cmd_raw() {
  [[ -n ${1:-} ]] || die "usage: xtream raw <ACTION>"
  api "$1"
}

# The verdict on an unfamiliar playlist, cheapest data first.
#
# Deliberately does NOT call cmd_counts: movie and series catalogues run to
# 60MB+ each on a large panel, which is minutes of waiting for two numbers.
# Status and categories are small, and the live list is the one people
# actually want to search.
cmd_quick() {
  cmd_status
  echo

  local cats total
  cats="$(api_cached get_live_categories)" || exit 1
  total="$(jq 'length' <<<"$cats")"

  echo "${D}categories ($total)${N}"
  # Slice inside jq: piping into `head` kills jq with SIGPIPE once the output
  # outgrows the pipe buffer, and pipefail turns that into a fatal error.
  jq -r '.[0:12][] | "  \(.category_name)"' <<<"$cats"
  ((total > 12)) && echo "  ${D}… and $((total - 12)) more${N}"
  echo

  local live
  live="$(api_cached get_live_streams)" || exit 1
  printf 'live channels  %s\n' "$(jq 'length' <<<"$live")"
  echo "${D}movies/series: xtream counts (downloads the full catalogue)${N}"
  echo
  echo "${D}next:${N} xtream search <name>   xtream check <id>   xtream save <profile>"
}

cmd_save() {
  local name="${1:-default}"
  local conf="$CONFIG_DIR/$name.conf"

  if [[ -e $conf && -z ${FORCE:-} ]]; then
    die "$conf already exists — pass -f to overwrite"
  fi

  mkdir -p "$CONFIG_DIR"
  umask 077
  cat >"$conf" <<EOF
XTREAM_HOST=$XTREAM_HOST
XTREAM_USER=$XTREAM_USER
XTREAM_PASS=$XTREAM_PASS
EOF
  chmod 600 "$conf"
  echo "${G}✓ saved profile '$name'${N} → $conf"
  [[ $name == default ]] || echo "  use it with: xtream -p $name status"
}

# Run one command against the line that is already loaded. Shared by main and
# by the single-line shortcut in cmd_batch, so `dump.txt -n 3384 play 756470`
# is the same code path as a bare `xtream <url> play 756470` — picker and
# player included, which a batch worker could never have.
run_command() {
  local cmd="$1"
  [[ $# -gt 0 ]] && shift

  case "$cmd" in
  status) cmd_status ;;
  quick) cmd_quick ;;
  batch) cmd_batch "$@" ;;
  save) cmd_save "${1:-default}" ;;
  search) cmd_search "${1:-}" ;;
  categories | cats) cmd_categories ;;
  url) cmd_url "${1:-}" ;;
  play) cmd_play "${1:-}" ;;
  check) cmd_check "${1:-}" ;;
  playable) cmd_playable "${1:-}" ;;
  counts) cmd_counts "$@" ;;
  raw) cmd_raw "${1:-}" ;;
  help) usage ;;
  *) die "unknown command '$cmd' (try --help)" ;;
  esac
}

# -------------------------------------------------------------------- main ---

main() {
  # Options are read from anywhere on the line, not just the front: the natural
  # way to type these is source first, flags after — `xtream dump.txt -n 3384
  # search bbc`. Everything that isn't a flag or a flag's value is collected
  # and replayed as the command.
  local -a rest=()
  while (($#)); do
    case "$1" in
    --)
      shift
      while (($#)); do rest+=("$1"); shift; done
      break
      ;;
    -p | --profile)
      PROFILE="${2:?--profile needs a name}"
      shift 2
      ;;
    -t | --type)
      KIND="${2:?--type needs live|vod|series}"
      shift 2
      ;;
    -u | --url)
      URL_OVERRIDE="${2:?--url needs a playlist URL}"
      shift 2
      ;;
    -c | --connect-timeout)
      CONNECT_TIMEOUT="${2:?--connect-timeout needs seconds}"
      shift 2
      ;;
    -T | --timeout)
      TIMEOUT="${2:?--timeout needs seconds}"
      BATCH_TIMEOUT="$2"
      shift 2
      ;;
    -j | --jobs)
      BATCH_CONCURRENCY="${2:?--jobs needs a number}"
      JOBS_SET=1
      shift 2
      ;;
    -n | --only)
      ONLY="${2:?--only needs a line number, range or list}"
      shift 2
      ;;
    -C | --category)
      CATQ="${2:?--category needs a regex}"
      shift 2
      ;;
    -m | --must)
      MUST="${2:?--must needs a channel name (or a comma-separated list)}"
      shift 2
      ;;
    -z | --timezone)
      TZQ="${2:?--timezone needs a regex, e.g. london}"
      shift 2
      ;;
    -a | --all)
      SHOW_ALL=1
      shift
      ;;
    -s | --skip)
      SKIP_SEEN="$(parse_duration "${2:?--skip needs a duration, e.g. 7d}")"
      SKIP_SPEC="$2"
      shift 2
      ;;
    -o | --out)
      if out_takes_value "${2:-}"; then
        setup_out "$2"
        shift 2
      else
        setup_out ""
        shift
      fi
      ;;
    -r | --refresh)
      REFRESH=1
      shift
      ;;
    -v | --stats)
      STATS=1
      shift
      ;;
    -f | --force)
      FORCE=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*) die "unknown option '$1' (try --help)" ;;
    *) rest+=("$1"); shift ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}

  case "$KIND" in
  live | vod | series) ;;
  *) die "unknown type '$KIND' (use live, vod or series)" ;;
  esac

  need curl
  need jq

  # A shared dump — base64 paste code or a paste.sh URL — expands to many
  # lines, so it routes to batch mode instead of loading a single line.
  if [[ ${1:-} == batch ]]; then
    shift
    cmd_batch "$@"
    return
  fi
  if [[ -n ${1:-} ]] && { [[ ${1} == *paste.sh/* ]] || maybe_base64_url "$1" >/dev/null; }; then
    cmd_batch "$@"
    return
  fi

  # A local file of dumped lines expands the same way — hand it straight to
  # batch. Checked before the URL fast paths so a path is never mistaken for a
  # command.
  if [[ -n ${1:-} && -f ${1} ]]; then
    cmd_batch "$@"
    return
  fi

  # A bare URL as the first argument is the fast path: paste what the provider
  # sent you and get a verdict, no profile setup.
  local default_cmd="status"
  if [[ ${1:-} == http://* || ${1:-} == https://* ]]; then
    URL_OVERRIDE="$1"
    default_cmd="quick"
    shift
  elif [[ ${1:-} == stalker:* ]]; then
    URL_OVERRIDE="$1"
    shift
  fi

  local cmd="${1:-$default_cmd}"
  [[ $# -gt 0 ]] && shift

  load_config
  run_command "$cmd" "$@"
}

main "$@"
